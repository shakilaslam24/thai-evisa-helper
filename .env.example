# ---------------------------------------------------------------------------
# DreamFly Consultancy — website environment
# Copy to `.env` and fill in. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Database. SQLite by default. A relative path is resolved against the
# application's working directory (the project root), not against prisma/.
#
# The filename says "website" on purpose. DreamFly's CRM also keeps a SQLite
# database in a data/ folder, and when both were called dreamfly.db, running
# the CRM once from inside this project left its database exactly where this
# site expected its own. The scripts now refuse to write to a database that
# holds another application's tables, but a distinct name avoids the question.
#
# For PostgreSQL: postgresql://user:password@host:5432/dreamfly
DATABASE_URL="file:./data/dreamfly-website.db"

# Public site origin, with no trailing slash.
#
# Used for canonical URLs, the sitemap, Open Graph tags, and to decide whether
# https-only security headers are sent.
#
# ON THE SERVER this MUST be the real https address:
#   NEXT_PUBLIC_SITE_URL="https://dreamfly.bd"
# Getting that wrong is quiet but expensive: an http:// value tells Google the
# insecure address is canonical, and secure admin cookies stop being sent.
#
# LOCALLY leave it as the line below. Setting an https:// value on a local
# http server makes Safari rewrite every stylesheet, script and image request
# to https://localhost, and the page renders as bare, unstyled HTML.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Secret used to sign admin session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Where uploaded media is written. Must be a writable, PERSISTENT directory.
# Deliberately NOT inside public/: Next.js indexes that directory when the
# server boots, so an image uploaded afterwards would 404 until a restart.
# Files here are served at /uploads/<filename> by a route handler.
UPLOAD_DIR="./data/uploads"

# Maximum upload size in bytes (default 8 MB).
MAX_UPLOAD_BYTES="8388608"

# Port the site listens on.
#
# DreamFly's CRM uses 3000, so this site stays off it: two servers on one port
# means whichever starts second fails, or nginx sends traffic meant for the
# website to the CRM. `next start` does not read this file, so `npm run dev`
# and `npm start` go through scripts/serve.mjs, which does. An exported
# PORT still wins: `PORT=4000 npm start`.
PORT="3100"

# Timezone the server interprets dates in.
#
# A campaign scheduled to end on the 31st ends at 23:59 in THIS zone. Left
# unset, a VPS is almost always UTC, so a Dhaka business would see banners turn
# over six hours late. Dates shown in the admin follow it too.
#
# Read before the server starts (scripts/serve.mjs loads this file first), so
# it applies to `npm run dev` and `npm start` alike.
TZ="Asia/Dhaka"

# Set to "1" behind a trusted reverse proxy so the real client IP is read from
# X-Forwarded-For for rate limiting. Leave unset if not behind a proxy.
TRUST_PROXY="1"
