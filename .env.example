# Copy to .env (or export these) before running in production.

# ── Basics ─────────────────────────────────────────────────────────
PORT=3000
# Where the SQLite database and uploaded documents live.
DATA_DIR=./data
# Where backups are written. Keep a copy off this server as well.
BACKUP_DIR=./backups

# ── Timezone — set this, it is not optional ────────────────────────
# Dates, times and every reminder are stored and compared on the server's own
# clock. A VPS bought outside Bangladesh runs on UTC, and follow-ups would then
# fire six hours late. The system warns at startup if this is missing.
TZ=Asia/Dhaka

# ── Behind a reverse proxy ─────────────────────────────────────────
# Set to 1 ONLY when nginx, Caddy or Cloudflare sits in front and terminates
# TLS. It tells the app to believe X-Forwarded-For, which is what the rate
# limiters count against — with no proxy in front, leave it unset, or anyone
# can send that header themselves and slip past the limits.
# TRUST_PROXY=1

# Marks session cookies Secure even when the app cannot see that the request
# arrived over HTTPS. Normally unnecessary: the cookie is marked Secure
# automatically for any HTTPS request, and NODE_ENV=production also forces it.
# FORCE_SECURE_COOKIES=1

NODE_ENV=production

# ── First administrator ────────────────────────────────────────────
# Only used when creating the very first admin, on an empty database. After
# that, use:  npm run admin -- --email you@company.com --password '…'
# ADMIN_EMAIL=you@company.com
# ADMIN_NAME=Your Name
# ADMIN_PASSWORD=

# How many database backups to keep (default 14).
# BACKUP_KEEP=14
